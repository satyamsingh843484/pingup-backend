// packages/server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String?   @unique
  phoneNumber   String?   @unique
  
  // ✨ FIX: Password ko optional (?) banaya taaki Google/Phone users aaram se save ho sakein
  password      String?   
  
  // ✨ NAYA: Ye batayega ki user kahan se aaya ("local", "google", ya "phone")
  authProvider  String    @default("local") 
  
  // Naye Profile Features
  isPro         Boolean   @default(false)
  streakCount   Int       @default(0)
  lastLogin     DateTime?
  
  createdAt     DateTime  @default(now())

  // Relations
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  stories          Story[]   
  storyViews       StoryView[] @relation("ViewerRelation")
  
  // 📞 NAYA: Call History Relations
  callsMade        CallHistory[] @relation("Caller")
  callsReceived    CallHistory[] @relation("Receiver")
  lastSeen  DateTime @default(now())

  pushToken    String?
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String?  // Isko optional (String?) kar do taaki sirf photo bhi bhej sakein
  mediaUrl   String?  // ✨ NAYA: Photo/Video ka cloud link save karne ke liye
  mediaType  String?  // ✨ NAYA: 'image' ya 'video'
  status     String   @default("sent")
  createdAt  DateTime @default(now())

  isDeleted  Boolean  @default(false)

  deletedBySender   Boolean  @default(false) 
  deletedByReceiver Boolean  @default(false)
  
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// ✨ NAYA: Text Story Model
model Story {
  id              Int         @id @default(autoincrement())
  userId          Int
  content         String      // Story ka text
  backgroundColor String      // Background color (e.g., "#FF5733")
  fontFamily      String?
  createdAt       DateTime    @default(now())
  expiresAt       DateTime    // Exact 24 ghante baad ka time
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views           StoryView[] // Kis kisne dekha aur like kiya
}

// ✨ NAYA: Story View & Like Tracking Model
model StoryView {
  id        Int      @id @default(autoincrement())
  storyId   Int
  viewerId  Int
  isLiked   Boolean  @default(false) // Like kiya ya nahi
  viewedAt  DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation("ViewerRelation", fields: [viewerId], references: [id], onDelete: Cascade)

  // Ek user ek story ko ek hi baar view record karega
  @@unique([storyId, viewerId]) 
}

// 📞 NAYA MODEL: Call History ke liye
model CallHistory {
  id         Int      @id @default(autoincrement())
  type       String   // "audio" or "video"
  status     String   // "missed", "completed", "declined"
  duration   Int?     // Seconds me
  createdAt  DateTime @default(now())

  callerId   Int
  caller     User     @relation("Caller", fields: [callerId], references: [id])
  
  receiverId Int
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])

  deletedByCaller   Boolean @default(false)
  deletedByReceiver Boolean @default(false)
  
}